@page
@model Aplicatie_Culinara_HealPlate.Pages.StatisticaUtilizatoriModel
@{
    ViewData["Title"] = "Statistica Utilizatori";
    var numeUtilizator = HttpContext.Session.GetString("NumeUtilizator");
    var rolUtilizator = HttpContext.Session.GetString("Rol");
    var idUtilizator = HttpContext.Session.GetInt32("IdUtilizator");
    @Html.AntiForgeryToken()
    ;
}

<!DOCTYPE html>
<html>
<head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <!-- Site Metas -->
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <link rel="shortcut icon" href="images/favicon.png" type="">

    <title>Rețete Culinare</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" type="text/css" href="css/bootstrap.css" />
    <!-- Owl Carousel CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <!-- Nice Select CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/css/nice-select.min.css" />
    <!-- Font Awesome CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link href="css/style.css" rel="stylesheet" />
    <!-- Responsive CSS -->
    <link href="css/responsive.css" rel="stylesheet" />
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />

</head>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <ul class="navbar-nav ms-auto d-flex flex-row align-items-center">
            @if (!string.IsNullOrEmpty(numeUtilizator))
            {
                <!-- Icon utilizator + nume -->
                <li class="nav-item d-flex align-items-center me-3">
                    <i class="fas fa-user text-dark me-1"></i>
                    <span class="text-dark">Bun venit, <strong>@numeUtilizator!</strong></span>
                </li>

                <!-- Logout vizibil -->
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center" href="/Autentificare" title="Deconectare">
                        <i class="fas fa-sign-out-alt fa-lg text-danger" style="margin-left: 10px;"></i>
                    </a>
                </li>
            }
        </ul>
    </div>
</nav>
<body>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCd6i5o5eD1fOMu_Yc5ENGZUSveTqO91NA&libraries=places&async&defer"></script>
    <div class="container mt-5">
        <h2 class="text-center">Statistica Utilizatori</h2>
        @{
            var utilizatoriFaraSine = Model.Utilizatori.Where(u => u.IdUtilizator != idUtilizator).ToList();
        }
        @if (rolUtilizator == "Admin")
        {
            <h4 class="mt-4">Lista Utilizatorilor și Alergenii lor</h4>
            @if (utilizatoriFaraSine.Any())
            {
                <table class="table table-bordered table-striped">
                    <thead class="thead-dark">
                        <tr>
                            <th>#</th>
                            <th>Nume</th>
                            <th>Prenume</th>
                            <th>Email</th>
                            <th>Alergeni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (utilizator, index) in utilizatoriFaraSine.Select((u, i) => (u, i + 1)))
                        {
                            <tr>
                                <td>@index</td>
                                <td>@utilizator.Nume</td>
                                <td>@utilizator.Prenume</td>
                                <td>@utilizator.Email</td>
                                <td>
                                    @{
                                        var alergeni = utilizator.UtilizatorAlergenis
                                        .Select(ua => ua.IdAlergenNavigation.NumeAlergen)
                                        .ToList();

                                        if (alergeni.Any())
                                        {
                                            @string.Join(", ", alergeni)
                                        }
                                        else
                                        {
                                            <span class="text-muted">Niciun alergen</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">Nu există utilizatori în baza de date.</p>
            }
            <h4 class="mt-5">Statistica celor mai Apreciate Retete</h4>
            <div class="card p-4">
                <canvas id="chartRetete"></canvas>
            </div>
        }
        else
        {
            var utilizatorCurent = Model.Utilizatori.FirstOrDefault(u => u.IdUtilizator == idUtilizator);

            @if (utilizatorCurent != null)
            {
                <h4 class="mt-4">Informatii despre tine</h4>
                <table class="table table-bordered table-striped">
                    <thead class="thead-dark">
                        <tr>
                            <th>Nume</th>
                            <th>Prenume</th>
                            <th>Email</th>
                            <th>Alergeni</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@utilizatorCurent.Nume</td>
                            <td>@utilizatorCurent.Prenume</td>
                            <td>@utilizatorCurent.Email</td>
                            <td>
                                @{
                                    var alergeni = utilizatorCurent.UtilizatorAlergenis
                                    .Select(ua => ua.IdAlergenNavigation.NumeAlergen)
                                    .ToList();

                                    if (alergeni.Any())
                                    {
                                        @string.Join(", ", alergeni)
                                    }
                                    else
                                    {
                                        <span class="text-muted">Niciun alergen</span>
                                    }
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="mt-4 mb-4">
                    <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#editAlergeni" aria-expanded="false" aria-controls="editAlergeni">
                        ✏️ Editare profil alergeni
                    </button>

                    <div class="collapse mt-3" id="editAlergeni">
                        <div class="card card-body">
                            <h5>🧾 Alergenii actuali</h5>
                            @if (Model.AlergeniUtilizator.Any())
                            {
                                <ul class="list-group">
                                    @foreach (var alergen in Model.AlergeniUtilizator)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @alergen.NumeAlergen
                                            <form method="post" asp-page-handler="StergeAlergen" class="m-0">
                                                <input type="hidden" name="idAlergen" value="@alergen.IdAlergen" />
                                                <button type="submit" class="btn btn-danger btn-sm">🗑️ Șterge</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted">Nu ai alergeni înregistrați.</span>
                            }

                            <hr />
                            <h5>➕ Adaugă un alergen</h5>
                            <form method="post" asp-page-handler="AdaugaAlergen">
                                <div class="input-group">
                                    <select name="idAlergenNou" class="form-select" required>
                                        <option value="" disabled selected>Alege un alergen</option>
                                        @foreach (var alergen in Model.TotiAlergenii
                                       .Where(a => !Model.AlergeniUtilizator.Any(ua => ua.IdAlergen == a.IdAlergen)))
                                        {
                                            <option value="@alergen.IdAlergen">@alergen.NumeAlergen</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-success">Adaugă</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <h5 class="mt-4">Statistici personale</h5>
                <div class="d-flex flex-wrap justify-content-center gap-4">

                    <div class="text-center">
                        <h6>Top 5 rețete folosite</h6>
                        <div class="card p-3" style="width: 300px; height: 250px;">
                            <canvas id="chartReteteFrecvente" style="max-height: 200px;"></canvas>
                        </div>
                    </div>

                    <div class="text-center">
                        <h6>Top 5 ingrediente frecvente</h6>
                        <div class="card p-3" style="width: 300px; height: 250px;">
                            <canvas id="chartIngredienteFrecvente" style="max-height: 200px;"></canvas>
                        </div>
                    </div>

                    <div class="text-center">
                        <h6>Timp gătit săptămânal</h6>
                        <div class="card p-3" style="width: 300px; height: 250px;">
                            <canvas id="chartTimpGatire" style="max-height: 200px;"></canvas>
                        </div>
                    </div>

                </div>


            }
            else
            {
                <p class="text-muted">Nu există date despre utilizator.</p>
            }
        }
        @if (rolUtilizator == "Admin")
        {
            <h4 class="mt-5">Statistica Alergenilor</h4>
            <div class="card p-4">
                <canvas id="chartAlergeni"></canvas>
            </div>
        }
    </div>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <script>
            document.addEventListener("DOMContentLoaded", function () {
            var ctxAlergeni = document.getElementById('chartAlergeni').getContext('2d');

            // Datele pentru alergeni
            var alergeniLabels = @Html.Raw(Json.Serialize(Model.StatisticaAlergeni.Keys));
            var alergeniValues = @Html.Raw(Json.Serialize(Model.StatisticaAlergeni.Values));

            // Generăm culori diferite pentru fiecare segment
            var colors = [
                '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF',
                '#FF9F40', '#8D6E63', '#26A69A', '#F06292', '#5C6BC0'
            ];

            // Graficul pentru alergeni
            var myPieChart = new Chart(ctxAlergeni, {
                type: 'pie',
                data: {
                    labels: alergeniLabels,
                    datasets: [{
                        data: alergeniValues,
                        backgroundColor: colors.slice(0, alergeniLabels.length),
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            callbacks: {
                                label: function (tooltipItem) {
                                    return ` ${alergeniLabels[tooltipItem.dataIndex]}: ${alergeniValues[tooltipItem.dataIndex]} utilizatori`;
                                }
                            }
                        }
                    }
                }
            });

            // Datele pentru statistica rețetelor cele mai apreciate
            var reteteLabels = @Html.Raw(Json.Serialize(Model.StatisticaRetete.Keys));
            var reteteValues = @Html.Raw(Json.Serialize(Model.StatisticaRetete.Values));

            // Graficul pentru rețetele cele mai apreciate
            var ctxRetete = document.getElementById('chartRetete').getContext('2d');
            var myBarChart = new Chart(ctxRetete, {
                type: 'bar',
                data: {
                    labels: reteteLabels,
                    datasets: [{
                        label: 'Număr de colecții',
                        data: reteteValues,
                        backgroundColor: '#4BC0C0', // culoare pentru bare
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function (tooltipItem) {
                                    return `${reteteLabels[tooltipItem.dataIndex]}: ${reteteValues[tooltipItem.dataIndex]} colecții`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'Rețete'
                            }
                        },
                        y: {
                            title: {
                                display: true,
                                text: 'Număr colecții'
                            },
                            beginAtZero: true
                        }
                    }
                }
            });
        });
                   document.addEventListener("DOMContentLoaded", function () {
            // TOP 5 RETETE 
            var reteteFrecventeLabels = @Html.Raw(Json.Serialize(Model.ReteteFrecventeUtilizator.Keys.Take(5)));
            var reteteFrecventeValues = @Html.Raw(Json.Serialize(Model.ReteteFrecventeUtilizator.Values.Take(5)));

            new Chart(document.getElementById('chartReteteFrecvente'), {
                type: 'bar',
                data: {
                    labels: reteteFrecventeLabels,
                    datasets: [{
                        label: 'Utilizări',
                        data: reteteFrecventeValues,
                        backgroundColor: '#FF6384',
                        borderRadius: 10
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        title: { display: true, text: 'Top 5 Rețete Folosite' }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: { display: true, text: 'Utilizări' }
                        }
                    }
                }
            });

            // TOP 5 INGREDIENTE 
            var ingredienteLabels = @Html.Raw(Json.Serialize(Model.IngredienteFrecventeUtilizator.Keys.Take(5)));
            var ingredienteValues = @Html.Raw(Json.Serialize(Model.IngredienteFrecventeUtilizator.Values.Take(5)));

            new Chart(document.getElementById('chartIngredienteFrecvente'), {
                type: 'doughnut',
                data: {
                    labels: ingredienteLabels,
                    datasets: [{
                        data: ingredienteValues,
                        backgroundColor: ['#4BC0C0', '#36A2EB', '#9966FF', '#FF9F40', '#FF6384']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        title: { display: true, text: 'Top 5 Ingrediente Frecvente' }
                    }
                }
            });

            // TIMP GATIRE SAPTAMANAL 
            var timpGatire = @Model.TimpGatireSaptamanal;
            var timpMaxim = 7 * 120; // presupunem 120 min/zi ca maxim
            var timpRamas = Math.max(0, timpMaxim - timpGatire);

            new Chart(document.getElementById('chartTimpGatire'), {
                type: 'doughnut',
                data: {
                    labels: ['Timp folosit', 'Timp rămas'],
                    datasets: [{
                        data: [timpGatire, timpRamas],
                        backgroundColor: ['#36A2EB', '#e0e0e0']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: { display: true, text: 'Timp gătit săptămânal (minute)' },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return `${context.label}: ${context.parsed} min`;
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

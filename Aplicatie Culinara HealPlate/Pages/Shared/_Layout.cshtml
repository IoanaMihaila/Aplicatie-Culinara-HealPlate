@{
    var rolUtilizator = Context.Session.GetString("Rol");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="images/favicon.png" type="">
    <title>@ViewData["Title"] - Aplicatie_Culinara_HealPlate</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Aplicatie_Culinara_HealPlate.styles.css" asp-append-version="true" />

    <style>
        #notificationButton {
            background-color: transparent; /* Fără fundal */
            border: none; /* Elimină bordura */
            outline: none; /* Elimină conturul la focus */
            box-shadow: none; /* Elimină umbrele */
        }

            #notificationButton:focus, #notificationButton:hover {
                background-color: transparent; /* Fără schimbări de culoare la hover sau focus */
                box-shadow: none; /* Fără efect de umbră */
                outline: none; /* Fără contur */
            }

            #notificationButton i {
                color: #000000; /* Asigură că pictograma rămâne neagră */
            }
    </style>
</head>
<body>
    <form id="antiForgeryForm" style="display: none;">
        @Html.AntiForgeryToken()
    </form>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Aplicatie_Culinara_HealPlate</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <partial name="_LoginPartial" />
                </div>

                <nav class="navbar navbar-expand-lg custom_nav-container">
                    <a class="navbar-brand" href="index.html">
                        <span>Heal Plate</span>
                    </a>

                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav mx-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="/Chestionar" style="color: #000000;">Chestionar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/RaportNutritie" style="color: #000000;">Raport Nutritie</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/VizualizareRetete" style="color: #000000;">Retete</a>
                            </li>
                            @if (rolUtilizator != "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/ColectiaPersonala" style="color: #000000;">Colectia Personala</a>
                                </li>
                            }
                        </ul>

                        <div class="user_option">
                            <div class="user_option d-flex">
                                <div class="dropdown">
                                    @await Component.InvokeAsync("Notificari")
                                </div>
                            </div>
                            <a href="/Chatbot" class="chatbot_link" title="Asistent AI Nutrițional" style="margin-left: 10px;">
                                <i class="fas fa-robot fa-lg" style="color: #198754;"></i>
                            </a>
                            <a href="/StatisticaUtilizatori" class="user_link">
                                <i class="fa fa-user" aria-hidden="true" style="color: #000000;"></i>
                            </a>
                            @if (rolUtilizator != "Admin")
                            {
                                <a href="/CosCumparaturi" class="cart_link">
                                    <!-- Cart icon SVG -->
                                    <svg version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 456.029 456.029" style="fill: #000000; width: 17px; height: auto;">
                                        <g>
                                            <g>
                                                <path d="M345.6,338.862c-29.184,0-53.248,23.552-53.248,53.248c0,29.184,23.552,53.248,53.248,53.248
                        c29.184,0,53.248-23.552,53.248-53.248C398.336,362.926,374.784,338.862,345.6,338.862z" />
                                            </g>
                                        </g>
                                        <g>
                                            <g>
                                                <path d="M439.296,84.91c-1.024,0-2.56-0.512-4.096-0.512H112.64l-5.12-34.304C104.448,27.566,84.992,10.67,61.952,10.67H20.48
                       C9.216,10.67,0,19.886,0,31.15c0,11.264,9.216,20.48,20.48,20.48h41.472c2.56,0,4.608,2.048,5.12,4.608l31.744,216.064
                       c4.096,27.136,27.648,47.616,55.296,47.616h212.992c26.624,0,49.664-18.944,55.296-45.056l33.28-166.4
                       C457.728,97.71,450.56,86.958,439.296,84.91z" />
                                            </g>
                                        </g>
                                        <g>
                                            <g>
                                                <path d="M215.04,389.55c-1.024-28.16-24.576-50.688-52.736-50.688c-29.696,1.536-52.224,26.112-51.2,55.296
                       c1.024,28.16,24.064,50.688,52.224,50.688h1.024C193.536,443.31,216.576,418.734,215.04,389.55z" />
                                            </g>
                                        </g>
                                    </svg> 
                                </a>
                                <a href="/PlanAlimentar" class="order_online">
                                    Plan<br>Alimentar
                                </a>
                            }
                        </div>
                    </div>
                </nav>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Aplicatie_Culinara_HealPlate - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
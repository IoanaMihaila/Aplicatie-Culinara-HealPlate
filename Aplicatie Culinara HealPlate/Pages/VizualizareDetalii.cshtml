@page
@model Aplicatie_Culinara_HealPlate.Pages.VizualizareDetaliiModel

@{
    ViewData["Title"] = "Detalii Rețetă";
    var numeUtilizator = HttpContext.Session.GetString("NumeUtilizator");
}

<!DOCTYPE html>
<html>
<head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <!-- Site Metas -->
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <link rel="shortcut icon" href="images/favicon.png" type="">

    <title>Rețete Culinare</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" type="text/css" href="css/bootstrap.css" />
    <!-- Owl Carousel CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <!-- Nice Select CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/css/nice-select.min.css" />
    <!-- Font Awesome CSS -->
    <link href="css/font-awesome.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link href="css/style.css" rel="stylesheet" />
    <!-- Responsive CSS -->
    <link href="css/responsive.css" rel="stylesheet" />
</head>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <ul class="navbar-nav ml-auto">
            <!-- Adaugă ml-auto pentru aliniere la dreapta -->
            @if (!string.IsNullOrEmpty(numeUtilizator))
            {
                <!-- Afisare nume utilizator autentificat -->
                <li class="nav-item">
                    <span class="navbar-text">
                        Bun venit, @numeUtilizator!
                    </span>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Logout">Logout</a>
                </li>
            }
        </ul>
    </div>
</nav>

<body>
    <div class="container">
        <h2>@Model.Reteta.Titlu</h2>
        <div class="row">
            <div class="col-md-6">
                <img src="@Url.Content(Model.Reteta.Imagine)" alt="@Model.Reteta.Titlu" class="img-fluid" />
            </div>
            <div class="col-md-6">
                <h4>Descriere</h4>
                <p>@Model.Reteta.Descriere</p>
                <h4>Mod de preparare</h4>
                <p>@Model.Reteta.ModDePreparare</p>
                <h4>Timp de preparare: @Model.Reteta.TimpPreparare minute</h4>
                <!-- Aici poți adăuga și alte informații relevante -->
            </div>
        </div>
        <div>
            <h4>Ingrediente</h4>
            <ul>
                @foreach (var ingredient in Model.Reteta.RetetaIngredientes)
                {
                    <li>@ingredient.IdIngredientNavigation.Nume - @ingredient.Cantitate @ingredient.Unitate</li>
                }
            </ul>
        </div>
        <!-- Mesaj de eroare dacă utilizatorul a lăsat deja o recenzie -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }
        <div>
            @if (string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <!-- Formularul POST pentru adăugarea unei recenzii -->
                <form method="post">
                    <div class="form-group">
                    <label for="recenzieText">Scrie o recenzie</label>
                    <textarea id="recenzieText" name="RecenzieText" class="form-control" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Adaugă recenzie</button>
            </form>
            }
        </div>
            <h4>Recenzii</h4>
            @foreach (var recenzie in Model.Reteta.Recenziis)
            {
                <div>
                    <strong>@recenzie.IdUtilizatorNavigation?.Nume @recenzie.IdUtilizatorNavigation?.Prenume</strong>
                    <p>@recenzie.TextRecenzie</p>
                </div>
            }
       
    </div>
</body>

</html>
@page
@model Aplicatie_Culinara_HealPlate.Pages.InspiratieModel
@{
    ViewData["Title"] = "Inspira-ma";
    var numeUtilizator = HttpContext.Session.GetString("NumeUtilizator");
    @Html.AntiForgeryToken()
}
<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Plan Alimentar</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <!-- FullCalendar -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Custom CSS for additional styling -->
    <link href="~/css/style.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
            text-align: center;
        }

        .container {
            margin-top: 50px;
            padding: 30px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .file-input {
            display: none;
        }

        .upload-label {
            display: inline-block;
            padding: 10px 20px;
            background-color: #ffc107;
            color: #343a40;
            border-radius: 5px;
            cursor: pointer;
        }

        .preview-container {
            margin-top: 20px;
            display: flex;
            justify-content: center;
            gap: 10px;
        }

            .preview-container img {
                width: 100px;
                height: 100px;
                object-fit: cover;
                border-radius: 5px;
                border: 2px solid #ddd;
            }

        .btn-upload {
            margin-top: 20px;
            background-color: #28a745;
            color: white;
            border-radius: 5px;
            padding: 10px 20px;
            border: none;
            cursor: pointer;
        }
    </style>
</head>
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container-fluid">
        <ul class="navbar-nav ms-auto">
            <!-- Adaugă ml-auto pentru aliniere la dreapta -->
            @if (!string.IsNullOrEmpty(numeUtilizator))
            {
                <!-- Afisare nume utilizator autentificat -->
                <li class="nav-item">
                    <span class="navbar-text">
                        <a href="" class="user_link">
                            <i class="fa fa-user" aria-hidden="true" style="color: #000000;"></i>
                        </a>
                        Bun venit, @numeUtilizator!
                    </span>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Autentificare"><i class="fas fa-sign-out-alt"></i> Logout</a>
                </li>
            }
        </ul>
    </div>
</nav>
<body>
    <div class="container mt-5 text-center">
        <h2>Ce poți găti azi cu ce ingrediente ai acasă?</h2>
        <p>Încarcă imagini cu ingredientele pe care le ai, iar noi îți vom sugera rețete potrivite.</p>
        <form id="uploadForm">
            <div class="form-group mb-3">
                <label for="imagine" class="form-label">Ingrediente</label>
                <div id="dropzone" class="border rounded d-flex align-items-center justify-content-center p-3"
                     style="width: 300px; height: 300px; cursor: pointer; background-color: #fafaf0; margin: 0 auto; position: relative; overflow: hidden;">
                    <p id="dropzone-text" class="text-muted text-center"
                       style="position: absolute; z-index: 1; width: 80%; text-align: center;">
                        Trageți și plasați imaginea aici sau faceți clic pentru a selecta
                    </p>
                    <input type="file" id="imagine" name="Imagine" class="d-none" accept="image/*" required />
                    <img id="image-preview" src="" alt="Imagine Previzualizare"
                         style="width: 100%; height: 100%; display: none; object-fit: cover; position: absolute; top: 0; left: 0;" />
                </div>
            </div>
            <button type="button" id="uploadButton" class="btn btn-warning mt-3">Trimite Imaginile</button>
        </form>
    </div>
    <script>
        // Drag and Drop pentru imagine
        const dropzone = document.getElementById('dropzone');
        const fileInput = document.getElementById('imagine');
        const imagePreview = document.getElementById('image-preview');
        const dropzoneText = document.getElementById('dropzone-text');

        dropzone.addEventListener('click', () => fileInput.click());

        dropzone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropzone.style.backgroundColor = '#eae6d6';
        });

        dropzone.addEventListener('dragleave', () => dropzone.style.backgroundColor = '#fafaf0');

        dropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropzone.style.backgroundColor = '#fafaf0';
            fileInput.files = e.dataTransfer.files;
            displayImage(fileInput.files[0]);
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length > 0) {
                displayImage(fileInput.files[0]);
            }
        });

            // Funcție pentru a afișa imaginea și a ascunde textul
                function displayImage(file) {
            const reader = new FileReader();
            const dropzoneText = document.getElementById('dropzone-text'); // Obține elementul text
            reader.onload = function (e) {
                imagePreview.src = e.target.result;
                imagePreview.style.display = 'block'; // Afișează imaginea
                if (dropzoneText) {
                    dropzoneText.style.display = 'none'; // Ascunde textul
                }
            };
            reader.readAsDataURL(file);
        }

                   document.getElementById('uploadButton').addEventListener('click', async function () {
            let fileInput = document.getElementById('imagine');
            let file = fileInput.files[0];

            if (!file) {
                Swal.fire("Eroare", "Vă rugăm să selectați o imagine!", "error");
                return;
            }

            // 1. Trimite imaginea la backend pentru a o salva și a primi un URL public
            let formData = new FormData();
            formData.append("Imagine", file);

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            formData.append("__RequestVerificationToken", token);


            const backendResponse = await fetch('/Inspiratie?handler=SalveazaImagine', {
                method: 'POST',
                body: formData
            });

            const backendData = await backendResponse.json();
            const imageUrl = backendData.url;

            if (!imageUrl) {
                Swal.fire("Eroare", "Nu s-a putut încărca imaginea.", "error");
                return;
            }

            // 2. Trimite URL-ul la RapidAPI pentru recunoaștere ingrediente
            const data = new URLSearchParams();
            data.append("url", imageUrl);

            const response = await fetch('https://objects-detection.p.rapidapi.com/objects-detection', {
                method: 'POST',
                headers: {
                    'x-rapidapi-key': '7fb61485a0mshe687d00c1901b51p1306c1jsnae721f78f3d2',
                    'x-rapidapi-host': 'objects-detection.p.rapidapi.com',
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: data
            });

            const apiData = await response.json();
            const obiecte = apiData.objects.map(obj => obj.name.toLowerCase());

            console.log("Ingrediente detectate:", obiecte);

            // 3. Trimite ingredientele la backend pentru a căuta rețeta
            const retetaResponse = await fetch('/Inspiratie?handler=GenerareReteta', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ingrediente: obiecte })
            });

            const rezultat = await retetaResponse.json();

            if (rezultat.reteta) {
                Swal.fire("Rețetă găsită!", `Sugestie: ${rezultat.reteta.nume}`, "success");
            } else {
                Swal.fire("Nicio rețetă găsită", "Încearcă alt ingredient.", "info");
            }
        });
    </script>
</body>
</html>
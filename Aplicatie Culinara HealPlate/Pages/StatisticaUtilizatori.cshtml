@page
@model Aplicatie_Culinara_HealPlate.Pages.StatisticaUtilizatoriModel
@{
    ViewData["Title"] = "Statistica Utilizatori";
    var numeUtilizator = HttpContext.Session.GetString("NumeUtilizator");
    var rolUtilizator = HttpContext.Session.GetString("Rol");
    var idUtilizator = HttpContext.Session.GetInt32("IdUtilizator");
    @Html.AntiForgeryToken();
}

<!DOCTYPE html>
<html>
<head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <!-- Site Metas -->
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <link rel="shortcut icon" href="images/favicon.png" type="">

    <title>Rețete Culinare</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" type="text/css" href="css/bootstrap.css" />
    <!-- Owl Carousel CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <!-- Nice Select CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/css/nice-select.min.css" />
    <!-- Font Awesome CSS -->
    <link href="css/font-awesome.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link href="css/style.css" rel="stylesheet" />
    <!-- Responsive CSS -->
    <link href="css/responsive.css" rel="stylesheet" />
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />

</head>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <ul class="navbar-nav ml-auto">
            <!-- Adaugă ml-auto pentru aliniere la dreapta -->
            @if (!string.IsNullOrEmpty(numeUtilizator))
            {
                <!-- Afisare nume utilizator autentificat -->
                <li class="nav-item">
                    <span class="navbar-text">
                        <a href="" class="user_link">
                            <i class="fa fa-user" aria-hidden="true" style="color: #000000;"></i>
                        </a>
                        Bun venit, @numeUtilizator!
                    </span>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Autentificare">Logout</a>
                </li>
            }
        </ul>
    </div>
</nav>
<body>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCd6i5o5eD1fOMu_Yc5ENGZUSveTqO91NA&libraries=places&async&defer"></script>
    <div class="container mt-5">
        <h2 class="text-center">Statistica Utilizatori</h2>
        @{
            var utilizatoriFaraSine = Model.Utilizatori.Where(u => u.IdUtilizator != idUtilizator).ToList();
        }
        @if(rolUtilizator=="Admin"){
            <h4 class="mt-4">Lista Utilizatorilor și Alergenii lor</h4>
            @if (utilizatoriFaraSine.Any())
            {
                <table class="table table-bordered table-striped">
                    <thead class="thead-dark">
                        <tr>
                            <th>#</th>
                            <th>Nume</th>
                            <th>Prenume</th>
                            <th>Email</th>
                            <th>Alergeni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (utilizator, index) in utilizatoriFaraSine.Select((u, i) => (u, i + 1)))
                        {
                            <tr>
                                <td>@index</td>
                                <td>@utilizator.Nume</td>
                                <td>@utilizator.Prenume</td>
                                <td>@utilizator.Email</td>
                                <td>
                                     @{
                                        var alergeni = utilizator.UtilizatorAlergenis
                                        .Select(ua => ua.IdAlergenNavigation.NumeAlergen)
                                        .ToList();

                                        if (alergeni.Any())
                                        {
                                            @string.Join(", ", alergeni)
                                        }
                                        else
                                        {
                                            <span class="text-muted">Niciun alergen</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }   
            else
            {   
                <p class="text-muted">Nu există utilizatori în baza de date.</p>
            }
            <h4 class="mt-5">Statistica celor mai Apreciate Retete</h4>
            <div class="card p-4">
                <canvas id="chartRetete"></canvas>
            </div>
        }
        else{
            var utilizatorCurent = Model.Utilizatori.FirstOrDefault(u => u.IdUtilizator == idUtilizator);

            @if (utilizatorCurent != null)
            {
                <h4 class="mt-4">Informatii despre tine</h4>
                <table class="table table-bordered table-striped">
                    <thead class="thead-dark">
                        <tr>
                            <th>Nume</th>
                            <th>Prenume</th>
                            <th>Email</th>
                            <th>Alergeni</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@utilizatorCurent.Nume</td>
                            <td>@utilizatorCurent.Prenume</td>
                            <td>@utilizatorCurent.Email</td>
                            <td>
                                @{
                                    var alergeni = utilizatorCurent.UtilizatorAlergenis
                                    .Select(ua => ua.IdAlergenNavigation.NumeAlergen)
                                    .ToList();

                                    if (alergeni.Any())
                                    {
                                        @string.Join(", ", alergeni)
                                    }
                                    else
                                    {
                                        <span class="text-muted">Niciun alergen</span>
                                    }
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="alert alert-info mt-4" role="alert">
                    <strong>Magazine în Timișoara:</strong> Găsește locuri care oferă produse fără alergeni. Căută pe hartă cele mai apropiate opțiuni!
                </div>
                <div id="map" style="height: 400px; width: 100%;"></div>
            }
            else
            {
                <p class="text-muted">Nu există date despre utilizator.</p>
            }
        }
        @if (rolUtilizator == "Admin")
        {
            <h4 class="mt-5">Statistica Alergenilor</h4>
            <div class="card p-4">
                <canvas id="chartAlergeni"></canvas>
            </div>
        }
    </div>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <script>
                document.addEventListener("DOMContentLoaded", function () {
            var ctxAlergeni = document.getElementById('chartAlergeni').getContext('2d');

            // Datele pentru alergeni
            var alergeniLabels = @Html.Raw(Json.Serialize(Model.StatisticaAlergeni.Keys));
            var alergeniValues = @Html.Raw(Json.Serialize(Model.StatisticaAlergeni.Values));

            // Generăm culori diferite pentru fiecare segment
            var colors = [
                '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF',
                '#FF9F40', '#8D6E63', '#26A69A', '#F06292', '#5C6BC0'
            ];

            // Graficul pentru alergeni
            var myPieChart = new Chart(ctxAlergeni, {
                type: 'pie',
                data: {
                    labels: alergeniLabels,
                    datasets: [{
                        data: alergeniValues,
                        backgroundColor: colors.slice(0, alergeniLabels.length),
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            callbacks: {
                                label: function (tooltipItem) {
                                    return ` ${alergeniLabels[tooltipItem.dataIndex]}: ${alergeniValues[tooltipItem.dataIndex]} utilizatori`;
                                }
                            }
                        }
                    }
                }
            });

            // Datele pentru statistica rețetelor cele mai apreciate
            var reteteLabels = @Html.Raw(Json.Serialize(Model.StatisticaRetete.Keys));
            var reteteValues = @Html.Raw(Json.Serialize(Model.StatisticaRetete.Values));

            // Graficul pentru rețetele cele mai apreciate
            var ctxRetete = document.getElementById('chartRetete').getContext('2d');
            var myBarChart = new Chart(ctxRetete, {
                type: 'bar',
                data: {
                    labels: reteteLabels,
                    datasets: [{
                        label: 'Număr de colecții',
                        data: reteteValues,
                        backgroundColor: '#4BC0C0', // culoare pentru bare
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function (tooltipItem) {
                                    return `${reteteLabels[tooltipItem.dataIndex]}: ${reteteValues[tooltipItem.dataIndex]} colecții`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'Rețete'
                            }
                        },
                        y: {
                            title: {
                                display: true,
                                text: 'Număr colecții'
                            },
                            beginAtZero: true
                        }
                    }
                }
            });
        });
                      function initMap() {
            // Inițializează harta
            var map = new google.maps.Map(document.getElementById('map'), {
                center: {lat: 45.7489, lng: 21.2087}, // București, de exemplu
                zoom: 12
            });

            // Definirea cererii pentru a căuta magazine bio
            var request = {
                location: map.getCenter(),
                radius: 5000,  // Căutăm într-o rază de 5 km
                keyword: 'magazin bio'  // Căutăm doar magazinele bio
            };

            // Creează un serviciu pentru Places API
            var service = new google.maps.places.PlacesService(map);

            // Execută cererea pentru a căuta magazine
            service.nearbySearch(request, function(results, status) {
                if (status === google.maps.places.PlacesServiceStatus.OK) {
                    // Dacă cererea a avut succes, marchează locațiile pe hartă
                    for (var i = 0; i < results.length; i++) {
                        var place = results[i];
                        var marker = new google.maps.Marker({
                            position: place.geometry.location,
                            map: map,
                            title: place.name
                        });

                        // Creează un InfoWindow pentru fiecare locație
                        var infowindow = new google.maps.InfoWindow({
                            content: '<div><strong>' + place.name + '</strong><br>' + place.vicinity + '</div>'
                        });

                        // Adaugă un eveniment de click pentru marker
                        (function(marker, infowindow) {
                            marker.addListener('click', function() {
                                infowindow.open(map, marker);
                            });
                        })(marker, infowindow);
                    }
                } else {
                    console.error('Error fetching places: ' + status);
                }
            });
        }
    </script>
    <body>
        <!-- Conținutul paginii -->

        <script>
            function loadGoogleMapsAPI() {
              var script = document.createElement('script');
              script.src = "https://maps.googleapis.com/maps/api/js?key=AIzaSyCd6i5o5eD1fOMu_Yc5ENGZUSveTqO91NA&libraries=places&callback=initMap";
              script.async = true;
              script.defer = true;
              document.head.appendChild(script);
            }

            // Call the function to load the API
            loadGoogleMapsAPI();
        </script>
    </body>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

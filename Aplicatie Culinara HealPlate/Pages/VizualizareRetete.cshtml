@page
@model Aplicatie_Culinara_HealPlate.Pages.VizualizareReteteModel
@{
    ViewData["Title"] = "Vizualizare Rețete";
    var numeUtilizator = HttpContext.Session.GetString("NumeUtilizator");
    var rolUtilizator = HttpContext.Session.GetString("Rol");
    @Html.AntiForgeryToken()
}

<!DOCTYPE html>
<html>
<head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <!-- Site Metas -->
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <link rel="shortcut icon" href="images/favicon.png" type="">
    <script src="~/js/site.js"></script>
    <link href="~/css/Aplicatie_Culinara_HealPlate.styles.css" rel="stylesheet" />

    <title>Rețete Culinare</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" type="text/css" href="css/bootstrap.css" />
    <!-- Owl Carousel CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <!-- Nice Select CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/css/nice-select.min.css" />
    <!-- Font Awesome CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link href="css/style.css" rel="stylesheet" />
    <!-- Responsive CSS -->
    <link href="css/responsive.css" rel="stylesheet" />
</head>

    <!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <ul class="navbar-nav ms-auto d-flex flex-row align-items-center">
            @if (!string.IsNullOrEmpty(numeUtilizator))
            {
                <!-- Icon utilizator + nume -->
                <li class="nav-item d-flex align-items-center me-3">
                    <i class="fas fa-user text-dark me-1"></i>
                    <span class="text-dark">Bun venit, <strong>@numeUtilizator!</strong></span>
                </li>

                <!-- Logout vizibil -->
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center" href="/Autentificare" title="Deconectare">
                        <i class="fas fa-sign-out-alt fa-lg text-danger" style="margin-left: 10px;"></i>
                    </a>
                </li>
            }
        </ul>
    </div>
</nav>
<body>
<section class="food_section layout_padding">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>
                Rețete Disponibile
            </h2>
        </div>

        <!-- Categorii -->
        <ul class="filters_menu">
            @foreach (var categorie in Model.Categorii)
            {
                <li class="@(Model.CategorieSelectata == categorie ? "active" : "")"
                    onclick="location.href='@Url.Page("VizualizareRetete", new { categorie = categorie })'">
                    @categorie
                </li>
            }
        </ul>
            <div style="display: flex; justify-content: center; align-items: center; height:5vh;">
                <form method="get" class="form-inline" style="margin-bottom: 20px;">
                    <input type="text" name="searchQuery" class="form-control" placeholder="Caută rețete sau ingrediente..." style="width: 300px; margin-right: 10px;">
                    <button class="btn my-2 my-sm-0 nav_search-btn" type="submit">
                        <i class="fa fa-search" aria-hidden="true" style="color: #000000;"></i>
                    </button>
                </form>
            </div>

        <!-- Rețete -->
        <div class="filters-content">
            <div class="row grid">
                @foreach (var reteta in Model.Retete)
                {
                    <div class="col-sm-6 col-lg-4 all @reteta.Categorie.ToLower()">
                        <div class="box">
                            <div class="img-box">
                                <img src="@Url.Content(reteta.Imagine)" alt="@reteta.Titlu" />
                            </div>
                            <div class="detail-box">
                                <h5>@reteta.Titlu</h5>
                                <p>@reteta.Descriere</p>
                                <div class="options">
                                    <button class="btn btn-detalii" onclick="window.location.href='@Url.Page("VizualizareDetalii", new { id = reteta.IdReteta })'">Detalii</button>
                                    <!-- Buton Inimioară pentru adăugare în colecție -->
                                        @if (rolUtilizator == "Utilizator")
                                        {
                                    <button class="btn btn-favorite" onclick="addToFavorites(event, @reteta.IdReteta)">
                                        <i class="@(Model.EsteInColectie.ContainsKey(reteta.IdReteta) && Model.EsteInColectie[reteta.IdReteta] ? "fas fa-heart" : "far fa-heart")"></i>
                                    </button>
                                        }
                                        else if (rolUtilizator == "Admin")
                                        {
                                            <!-- Buton de ștergere pentru admini -->
                                            <button class="btn btn-danger" onclick="deleteRecipe(event, @reteta.IdReteta)">
                                                <i class="fa fa-trash" aria-hidden="true"></i> Șterge
                                            </button>
                                        }

                                    <!-- Include scripturile JS -->
                                    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
                                    <script src="~/js/site.js"></script>
                                        <script>
                                            function deleteRecipe(event, idReteta) {
                                                event.preventDefault();

                                                if (!confirm('Sigur vrei să ștergi această rețetă?')) {
                                                    return;
                                                }
                                                fetch('?handler=DeleteRecipe', {
                                                    method: 'POST',
                                                    headers: {
                                                        'Content-Type': 'application/json',
                                                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                                                    },
                                                    body: JSON.stringify(idReteta),
                                                })
                                                .then((response) => {
                                                    console.log("Cerere trimisă către server: /VizualizareRetete?handler=DeleteRecipe"); // Log pentru confirmare
                                                    if (!response.ok) {
                                                        throw new Error(`Eroare de server: ${response.statusText}`);
                                                    }
                                                    return response.json();
                                                })
                                                .then((data) => {
                                                    if (data.success) {
                                                        Swal.fire({
                                                            icon: 'success',
                                                            title: 'Succes!',
                                                            text: 'Rețeta a fost ștearsă cu succes!',
                                                            confirmButtonText: 'OK'
                                                        }).then(() => {
                                                            location.reload(); // 🔄 Reîncarcă pagina după succes
                                                        });
                                                    } else {
                                                        Swal.fire({
                                                            icon: 'error',
                                                            title: 'Eroare',
                                                            text: data.message || 'A apărut o eroare la ștergerea rețetei.',
                                                            confirmButtonText: 'OK'
                                                        });
                                                    }
                                                })
                                                .catch((error) => {
                                                    Swal.fire({
                                                        icon: 'error',
                                                        title: 'Eroare',
                                                        text: `Ceva nu a mers bine: ${error.message}`,
                                                        confirmButtonText: 'OK'
                                                    });
                                                });
                                            }
                                        </script>
                                        <script>
                                            function addToFavorites(event, idReteta) {
                                            event.preventDefault(); // Previne comportamentul implicit

                                            console.log("ID-ul rețetei: ", idReteta); // Verifică dacă ID-ul rețetei este corect

                                            var button = event.target.closest("button");
                                            var icon = button.querySelector("i");

                                            // Verifică starea inimii (dacă este adăugată sau nu în colecție)
                                           var isFavorite = icon.classList.contains("fas");

                                            if (!isFavorite) {
                                                // Adaugă rețeta în colecția utilizatorului
                                                fetch('/VizualizareRetete?handler=AddToCollection', {
                                                    method: "POST",
                                                    headers: {
                                                        "Content-Type": "application/json",
                                                        "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                                                    },
                                                    body: JSON.stringify(idReteta),
                                                })
                                                .then((response) => {
                                                    console.log("Cerere trimisă către server: /VizualizareRetete?handler=AddToCollection"); // Log pentru confirmare
                                                    if (!response.ok) {
                                                        throw new Error(`Eroare de server: ${response.statusText}`);
                                                    }
                                                    return response.json();
                                                })
                                                .then((data) => {
                                                    if (data.success) {
                                                        Swal.fire({
                                                            icon: 'success',
                                                            title: 'Succes!',
                                                            text: 'Rețeta a fost cu succes adăugată în colecția ta personală!',
                                                            confirmButtonText: 'OK'
                                                        });
                                                        icon.classList.remove("far");
                                                        icon.classList.add("fas");
                                                    } else {
                                                        Swal.fire({
                                                            icon: 'error',
                                                            title: 'Eroare',
                                                            text: data.message || 'A apărut o eroare la adăugarea rețetei.',
                                                            confirmButtonText: 'OK'
                                                        });
                                                    }
                                                })
                                                .catch((error) => {
                                                    console.error("Eroare la adăugarea rețetei:", error);
                                                    Swal.fire({
                                                        icon: 'error',
                                                        title: 'Eroare',
                                                        text: 'A apărut o eroare la adăugarea rețetei. Detalii în consola browserului.',
                                                        confirmButtonText: 'OK'
                                                    });
                                                });
                                            } else {
                                                // Șterge rețeta din colecția utilizatorului
                                                fetch('/VizualizareRetete?handler=RemoveFromCollection', {
                                                    method: "POST",
                                                    headers: {
                                                        "Content-Type": "application/json",
                                                        "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                                                    },
                                                    body: JSON.stringify(idReteta),
                                                })
                                                .then((response) => {
                                                    if (!response.ok) {
                                                        throw new Error(`Eroare de server: ${response.statusText}`);
                                                    }
                                                    return response.json();
                                                })
                                                .then((data) => {
                                                    if (data.success) {
                                                        Swal.fire({
                                                            icon: 'success',
                                                            title: 'Succes!',
                                                            text: 'Rețeta a fost ștearsă din colecția ta!',
                                                            confirmButtonText: 'OK'
                                                        });
                                                        icon.classList.remove("fas");
                                                        icon.classList.add("far");
                                                    } else {
                                                        Swal.fire({
                                                            icon: 'error',
                                                            title: 'Eroare',
                                                            text: data.message || 'A apărut o eroare la ștergerea rețetei.',
                                                            confirmButtonText: 'OK'
                                                        });
                                                    }
                                                })
                                                .catch((error) => {
                                                    console.error("Eroare la ștergerea rețetei:", error);
                                                    Swal.fire({
                                                        icon: 'error',
                                                        title: 'Eroare',
                                                        text: 'A apărut o eroare la ștergerea rețetei. Detalii în consola browserului.',
                                                        confirmButtonText: 'OK'
                                                    });
                                                });
                                            }
                                        }

                                        </script>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (!Model.Retete.Any())
                {
                    <p style="text-align: center;">Nu sunt rețete disponibile pentru această categorie.</p>
                }
            </div>
        </div>
    </div>
</section>
</body>
</html>
<style>
    .btn-detalii {
        background-color: #8B4513; /* Maro */
        color: white; /* Text alb */
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        font-size: 1rem;
        cursor: pointer;
    }

        .btn-detalii:hover {
            background-color: #6A3C27; /* Maro mai închis la hover */
        }

    .btn-favorite {
        background-color: transparent;
        border: none;
        color: #e74c3c; /* Culoare roșie pentru inimioară */
        font-size: 1.5rem;
        cursor: pointer;
        transition: color 0.3s ease;
    }

        .btn-favorite:hover {
            color: #c0392b; /* Culoare mai închisă la hover */
        }

        .btn-favorite .fa-heart {
            color: #e74c3c; /* Culoare roșie pentru inimioară când este selectată */
        }
</style>
@page
@model Aplicatie_Culinara_HealPlate.Pages.VizualizareDetaliiModel

@{
    ViewData["Title"] = "Detalii Rețetă";
    var numeUtilizator = HttpContext.Session.GetString("NumeUtilizator");
    var rolUtilizator = HttpContext.Session.GetString("Rol");
    @Html.AntiForgeryToken()
}

<!DOCTYPE html>
<html>
<head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <!-- Site Metas -->
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <link rel="shortcut icon" href="images/favicon.png" type="">

    <title>Rețete Culinare</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" type="text/css" href="css/bootstrap.css" />
    <!-- Owl Carousel CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <!-- Nice Select CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/css/nice-select.min.css" />
    <!-- Font Awesome CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link href="css/style.css" rel="stylesheet" />
    <!-- Responsive CSS -->
    <link href="css/responsive.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        .review {
            border-bottom: 1px solid #ddd;
            padding: 10px 0;
            display: flex;
            justify-content: space-between;
        }

        .review-content {
            flex: 1;
        }

        .review-buttons {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 10px; /* Distanța între butoane */
        }

            .review-buttons .btn {
                background-color: #fff;
                color: #6c757d;
                border: 1px solid #6c757d;
            }

                .review-buttons .btn:hover {
                    background-color: #fff;
                }

        .btn-plus {
            padding: 2px 6px; /* Dimensiuni mici pentru buton */
            font-size: 0.8rem; /* Text mai mic */
            border-radius: 50%; /* Formă rotundă */
            display: inline-flex; /* Flexibil pentru centrul iconiței */
            align-items: center;
            justify-content: center;
            height: 24px; /* Dimensiune fixă */
            width: 24px; /* Dimensiune fixă */
            background-color: transparent; /* Fundal transparent */
            border: 1px solid #ccc; /* Border discret */
            color: #6c757d; /* Culoare neutru închis */
        }

            .btn-plus:hover {
                background-color: #f8f9fa; /* Fundal mai deschis la hover */
                border-color: #aaa; /* Border mai închis la hover */
                color: #000; /* Text mai vizibil */
            }

            .btn-plus i {
                margin: 0; /* Asigură centrare perfectă pentru icon */
            }
    </style>
</head>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <ul class="navbar-nav ms-auto d-flex flex-row align-items-center">
            @if (!string.IsNullOrEmpty(numeUtilizator))
            {
                <!-- Icon utilizator + nume -->
                <li class="nav-item d-flex align-items-center me-3">
                    <i class="fas fa-user text-dark me-1"></i>
                    <span class="text-dark">Bun venit, <strong>@numeUtilizator!</strong></span>
                </li>

                <!-- Logout vizibil -->
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center" href="/Autentificare" title="Deconectare">
                        <i class="fas fa-sign-out-alt fa-lg text-danger" style="margin-left: 10px;"></i>
                    </a>
                </li>
            }
        </ul>
    </div>
</nav>

<body>
    @if (rolUtilizator == "Admin")
    {
        <form method="get">
            <button type="button" class="btn btn-warning" onclick="enableEditing()">Modificare</button>
        </form>
    }
    <div class="container">
        @if (rolUtilizator == "Admin")
        {
            @if (Model.Reteta.Aprobata == true)
            {
                <div id="statusMessage" class="alert alert-success">Rețeta aprobată</div>
            }
            else if (Model.Reteta.Aprobata == false)
            {
                <div id="statusMessage" class="alert alert-danger">Rețeta respinsă</div>
            }
            else
            {
                <form id="approveForm" method="post" onsubmit="approveRecipe(@Model.Reteta.IdReteta); return false;">
                    <input type="hidden" name="IdReteta" value="@Model.Reteta.IdReteta" />
                    <button type="submit" class="btn btn-approve">Aproba postarea</button>
                </form>
                <form id="rejectForm" method="post" onsubmit="rejectRecipe(@Model.Reteta.IdReteta); return false;">
                    <input type="hidden" name="IdReteta" value="@Model.Reteta.IdReteta" />
                    <button type="submit" class="btn btn-reject">Respinge postarea</button>
                </form>
            }
        }
        <h2>@Model.Reteta.Titlu</h2>
        <div class="row">
            <div class="col-md-6">
                <img id="recipeImage" src="@Url.Content(Model.Reteta.Imagine)" alt="@Model.Reteta.Titlu" class="img-fluid" />
            </div>
            <div class="col-md-6">
                <h4>Descriere</h4>
                <p>@Model.Reteta.Descriere</p>
                <h4>Mod de preparare</h4>
                @if (rolUtilizator == "Utilizator"){
                    <p id="modPreparareText">@Model.Reteta.ModDePreparare</p>
                    <button class="btn btn-outline-success" onclick="initializareCitire()">
                        <i class="fa fa-play"></i>
                    </button>

                    <button class="btn btn-outline-secondary" onclick="ascultaComenziVocale()">
                        <i class="fa fa-microphone"></i>
                    </button>

                    <span id="statusPasCurent" class="ml-3 text-muted" style="font-weight: 600;"></span>
                }else if(rolUtilizator=="Admin"){
                    <textarea id="modDePreparare" class="form-control form-control-lg" disabled style="min-height: 250px;">
                        @Model.Reteta.ModDePreparare
                    </textarea>
                }
                <h4>Timp de preparare: @Model.Reteta.TimpPreparare minute </h4>
                <h4>Alergeni:</h4>
                <p>@ViewData["AlergeniReteta"]</p>
            </div>
        </div>
        <div>
            <h4>Ingrediente</h4>

            <ul id="ingredientList">
                @foreach (var ingredient in Model.Reteta.RetetaIngredientes)
                {

                    <li data-id="@ingredient.IdIngredient">
                        @if (rolUtilizator == "Utilizator")
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary btn-plus"
                                    onclick="adaugaInCos(@ingredient.IdIngredient, @ingredient.Cantitate, '@ingredient.Unitate')">
                                <i class="fa fa-plus"></i>
                            </button>
                        }
                        else if (rolUtilizator == "Admin")
                        {
                            <input type="text" class="ingredient-name" value="@ingredient.IdIngredientNavigation.Nume" disabled />
                            <input type="number" class="ingredient-quantity" value="@ingredient.Cantitate" min="1" disabled />
                            <select class="ingredient-unit" disabled>
                                <option selected>@ingredient.Unitate</option>
                                <option value="g">g</option>
                                <option value="ml">ml</option>
                                <option value="buc">buc</option>
                            </select>
                        }
                        @ingredient.IdIngredientNavigation.Nume - @ingredient.Cantitate @ingredient.Unitate
                        @if (ingredient.IdIngredientNavigation.IngredientAlergenis != null && ingredient.IdIngredientNavigation.IngredientAlergenis.Any())
                        {
                            <span>
                                (Alergeni:
                                @foreach (var alergen in ingredient.IdIngredientNavigation.IngredientAlergenis)
                                {
                                    @if (alergen.IdAlergenNavigation != null)
                                    {
                                        @alergen.IdAlergenNavigation.NumeAlergen
                                        @if (!alergen.Equals(ingredient.IdIngredientNavigation.IngredientAlergenis.Last()))
                                        {
                                            <span>, </span> <!-- adaugă virgula între alergeni -->
                                        }
                                    }
                                    else
                                    {
                                        <span>(Alergen invalid)</span>
                                    }
                                }
                                )
                            </span>
                        }
                    </li>
                }
            </ul>
        </div>

        <!-- Mesaj de eroare dacă utilizatorul a lăsat deja o recenzie -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }
        <div>
            @if (string.IsNullOrEmpty(Model.ErrorMessage) && rolUtilizator == "Utilizator")
            {
                <!-- Formularul POST pentru adăugarea unei recenzii -->
                <form method="post">
                    <div class="form-group">
                        <label for="recenzieText">Scrie o recenzie</label>
                        <textarea id="recenzieText" name="RecenzieText" class="form-control" rows="3"></textarea>
                        <div class="mt-2 d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-outline-primary" onclick="pornesteInregistrarea()" title="Înregistrează">
                                <i class="fa fa-microphone"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger" onclick="opresteInregistrarea()" title="Oprește înregistrarea">
                                <i class="fa fa-stop"></i>
                            </button>
                            <small id="statusVocal" class="form-text text-muted ml-2"></small>
                        </div>
                        <small id="statusVocal" class="form-text text-muted ml-2"></small>
                    </div>
                    <div class="form-group">
                        <label for="scor">Acordă un scor:</label>
                        <select id="scor" name="Scor" class="form-control">
                            <option value="1">⭐</option>
                            <option value="2">⭐⭐</option>
                            <option value="3">⭐⭐⭐</option>
                            <option value="4">⭐⭐⭐⭐</option>
                            <option value="5">⭐⭐⭐⭐⭐</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Adaugă recenzie</button>
                </form>
            }
        </div>
        <h4>Recenzii</h4>
        @foreach (var recenzie in Model.Reteta.Recenziis)
        {
            <div class="review d-flex justify-content-between">
                <div class="review-content">
                    <strong>@recenzie.IdUtilizatorNavigation?.Nume @recenzie.IdUtilizatorNavigation?.Prenume</strong>
                    <span class="text-muted">@recenzie.DataRecenzie</span>
                    <p>
                        @for (int i = 0; i < recenzie.Scor; i++)
                        {
                            <span style="color: gold;">⭐</span>
                        }
                    </p>
                    <p>@recenzie.TextRecenzie</p>
                </div>

                @if (recenzie.IdUtilizator == HttpContext.Session.GetInt32("IdUtilizator") && rolUtilizator == "Utilizator")
                {
                    <div class="review-buttons d-flex flex-column justify-content-start mr-sm-5">
                        <button type="button" class="btn btn-custom mb-2" onclick="toggleEditForm()">Editează</button>
                        <!-- Secțiunea pentru modificarea recenziei (inițial ascunsă) -->
                        <div id="editForm" style="display: none;">
                            <form method="post" asp-page="./VizualizareDetalii" asp-page-handler="EditareRecenzie" class="mb-2">
                                <input type="hidden" name="id" value="@recenzie.IdRecenzie" />
                                <textarea name="textNou" rows="2" class="form-control">@recenzie.TextRecenzie</textarea>
                                <label for="scor">Acordă un scor:</label>
                                <select id="scor" name="scorNou" class="form-control">
                                    <option value="1">⭐</option>
                                    <option value="2">⭐⭐</option>
                                    <option value="3">⭐⭐⭐</option>
                                    <option value="4">⭐⭐⭐⭐</option>
                                    <option value="5">⭐⭐⭐⭐⭐</option>
                                </select>
                                <button type="submit" class="btn btn-primary">Salvează modificările</button>
                            </form>
                        </div>

                        <form method="post" asp-page="./VizualizareDetalii" asp-page-handler="StergereRecenzie">
                            <input type="hidden" name="id" value="@recenzie.IdReteta" />
                            <button type="submit" class="btn btn-danger mt-2">Șterge</button>
                        </form>
                    </div>
                }
                else if (rolUtilizator == "Admin")
                {
                    <form method="post" asp-page="./VizualizareDetalii" asp-page-handler="StergereRecenzie">
                        <input type="hidden" name="id" value="@recenzie.IdReteta" />
                        <button type="submit" class="btn btn-danger mt-2">Șterge</button>
                    </form>
                }
            </div>
        }
    </div>

        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>
                   let recognizer;
            let rezultatFinal = "";

            function pornesteInregistrarea() {
                const status = document.getElementById("statusVocal");

                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (!SpeechRecognition) {
                    alert("Browserul tău nu suportă recunoaștere vocală.");
                    return;
                }

                recognizer = new SpeechRecognition();
                recognizer.lang = "ro-RO";
                recognizer.interimResults = false;
                recognizer.maxAlternatives = 1;

                rezultatFinal = "";
                status.innerText = "🎙️ Ascult... Vorbește acum.";

                recognizer.start();

                recognizer.onresult = function (event) {
                    rezultatFinal = event.results[0][0].transcript;
                    status.innerText = "📝 Transcriere completă.";
                };

                recognizer.onerror = function (event) {
                    status.innerText = "❌ Eroare: " + event.error;
                    console.error("Eroare:", event.error);
                };
            }

            function opresteInregistrarea() {
                if (recognizer) {
                    recognizer.stop();

                    recognizer.onend = function () {
                        const textarea = document.getElementById("recenzieText");
                        const status = document.getElementById("statusVocal");

                        if (rezultatFinal) {
                            textarea.value += (textarea.value ? " " : "") + rezultatFinal;
                            status.innerText = "✅ Textul a fost adăugat în câmpul de recenzie.";
                        } else {
                            status.innerText = "⚠️ Nu s-a detectat nicio voce.";
                        }
                    };
                }
            }


               function citesteReteta() {
               const modPreparare = document.getElementById("modPreparareText").innerText;

                if ('speechSynthesis' in window) {
                    const mesaj = new SpeechSynthesisUtterance(modPreparare);
                    mesaj.lang = 'ro-RO'; // limba română
                    speechSynthesis.speak(mesaj);
                } else {
                    alert("Browserul tău nu suportă citirea vocală.");
                }
            }

              function enableEditing() {
                console.log("Activare editare...");

            // Activare câmp pentru modul de preparare
            let modDePreparareTextarea = document.getElementById("modDePreparare");
            if (modDePreparareTextarea) {
                modDePreparareTextarea.removeAttribute("disabled");
            }

                let ingredientItems = document.querySelectorAll("#ingredientList li");

                if (ingredientItems.length === 0) {
                    console.error("Nu s-au găsit ingrediente!");
                    return;
                }

                ingredientItems.forEach(item => {
                    let nameInput = item.querySelector(".ingredient-name");
                    let quantityInput = item.querySelector(".ingredient-quantity");
                    let unitSelect = item.querySelector(".ingredient-unit");

                    nameInput.removeAttribute("disabled");
                    quantityInput.removeAttribute("disabled");
                    unitSelect.removeAttribute("disabled");

                    // Adăugăm un buton de salvare
                    let saveBtn = document.createElement("button");
                    saveBtn.textContent = "Salvează";
                    saveBtn.classList.add("btn", "btn-success", "btn-sm");
                    saveBtn.onclick = function () {
                        saveIngredientChanges(item);
                    };

                    item.appendChild(saveBtn);
                });
                        // Adăugare buton de salvare pentru modul de preparare
            let savePrepBtn = document.createElement("button");
            savePrepBtn.textContent = "Salvează";
            savePrepBtn.classList.add("btn", "btn-primary", "mt-3");
            savePrepBtn.onclick = function () {
                savePreparationChanges();
            };

            document.getElementById("modDePreparare").parentNode.appendChild(savePrepBtn);
            }

             function saveIngredientChanges(item) {
                let ingredientId = item.getAttribute("data-id");
                let recipeId = @Model.Reteta.IdReteta // Adaugă ID-ul rețetei
                let nameInput = item.querySelector(".ingredient-name").value.trim();
                let quantityInput = item.querySelector(".ingredient-quantity").value;
                let unitSelect = item.querySelector(".ingredient-unit").value;

                if (!nameInput || !quantityInput || quantityInput <= 0) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Eroare',
                        text: 'Introduceți un nume valid și o cantitate pozitivă!',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                console.log("Salvare ingredient ID:", ingredientId, "| Nou nume:", nameInput, "| Noua cantitate:", quantityInput, "| Unitate:", unitSelect);

                fetch('/Vizualizaredetalii?handler=UpdateIngredient', {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        IdReteta: Number(recipeId),  // Adăugat ID-ul rețetei
                        IdIngredient: Number(ingredientId),
                        NumeIngredientNou: nameInput,
                        CantitateNoua: Number(quantityInput),
                        UnitateNoua: unitSelect
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Succes!',
                            text: 'Ingredient modificat cu succes!',
                            confirmButtonText: 'OK'
                            }).then(() => {
                location.reload(); // Reîncarcă pagina după ce utilizatorul apasă OK
            });
                    } else {
                        console.error("Eroare:", data.message);
                    }
                })
                .catch(error => console.error("Eroare la salvare:", error));
            }
                function savePreparationChanges() {
                let recipeId = @Model.Reteta.IdReteta;
                let newPreparation = document.getElementById("modDePreparare").value.trim();

                if (!newPreparation) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Eroare',
                        text: 'Modul de preparare nu poate fi gol!',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                console.log("Salvare mod de preparare:", newPreparation);

                fetch('/Vizualizaredetalii?handler=UpdatePreparation', {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        IdReteta: Number(recipeId),
                        ModDePreparareNou: newPreparation
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Succes!',
                            text: 'Mod de preparare modificat cu succes!',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        console.error("Eroare:", data.message);
                    }
                })
                .catch(error => console.error("Eroare la salvare:", error));
            }
        </script>
        <script>
            function adaugaInCos(idIngredient, cantitate, unitate) {
                 console.log("Parametri primiți:", { idIngredient, cantitate, unitate });
                const data = {
                    idIngredient: idIngredient,
                    cantitate: cantitate,
                    unitate: unitate.toString()
                };

                fetch('/Vizualizaredetalii?handler=AdaugaInCos', {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data),
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`Eroare de server: ${response.statusText}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Succes!',
                            text: 'Ingredient adăugat în coșul de cumpărături!',
                            confirmButtonText: 'OK'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Eroare',
                            text: data.message || 'A apărut o eroare la adăugarea ingredientului în coș.',
                            confirmButtonText: 'OK'
                        });
                    }
                })
                .catch(error => {
                    console.error("Eroare la adăugarea ingredientului în coș:", error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Eroare',
                        text: 'A apărut o eroare la adăugarea ingredientului. Detalii în consola browserului.',
                        confirmButtonText: 'OK'
                    });
                });
            }
        </script>
        <script>
            function approveRecipe(idReteta) {
                fetch('/VizualizareDetalii?handler=ApprovePost', {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ IdReteta: idReteta }),
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Succes!',
                            text: 'Rețeta a fost aprobată cu succes!',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            document.getElementById("approveForm").style.display = "none";
                            document.getElementById("rejectForm").style.display = "none";
                            document.getElementById("statusMessage").innerHTML = "Rețeta aprobată";
                            document.getElementById("statusMessage").classList.add("alert", "alert-success");
                        });
                    }
                })
                .catch(error => console.error("Eroare la aprobare:", error));
            }

            function rejectRecipe(idReteta) {
                Swal.fire({
                    title: 'Ești sigur?',
                    text: "Vrei să respingi această rețetă?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Da, respinge!',
                    cancelButtonText: 'Anulează'
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch('/VizualizareDetalii?handler=RejectPost', {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify({ IdReteta: idReteta }),
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Respins!',
                                    text: 'Rețeta a fost respinsă cu succes!',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    document.getElementById("approveForm").style.display = "none";
                                    document.getElementById("rejectForm").style.display = "none";
                                    document.getElementById("statusMessage").innerHTML = "Rețeta respinsă";
                                    document.getElementById("statusMessage").classList.add("alert", "alert-danger");
                                });
                            }
                        })
                        .catch(error => console.error("Eroare la respingere:", error));
                    }
                });
            }
        </script>
        <script>
            let pasi = [];
            let pasCurent = 0;
            let cititor;

            function initializareCitire() {
                const text = document.getElementById("modPreparareText").innerText;
                pasi = text.split(/[\.\n]/).map(p => p.trim()).filter(p => p.length > 0);
                pasCurent = 0;

                if (pasi.length === 0) {
                    alert("Modul de preparare este gol.");
                    return;
                }

                citestePas(pasCurent);
                actualizeazaStatus(pasCurent);
            }

            function citestePas(index) {
                if ('speechSynthesis' in window && pasi.length > index) {
                    speechSynthesis.cancel(); // oprește orice citire anterioară

                    cititor = new SpeechSynthesisUtterance(pasi[index]);
                    cititor.lang = 'ro-RO';

                    cititor.onend = () => {
                        actualizeazaStatus(index);
                    };

                    speechSynthesis.speak(cititor);
                }
            }

            function actualizeazaStatus(index) {
                const status = document.getElementById("statusPasCurent");
                status.innerText = `Pasul ${index + 1}/${pasi.length}`;
            }

            function ascultaComenziVocale() {
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (!SpeechRecognition) {
                    alert("Browserul tău nu suportă recunoaștere vocală.");
                    return;
                }

                const recognizer = new SpeechRecognition();
                recognizer.lang = "ro-RO";
                recognizer.interimResults = false;
                recognizer.continuous = false;

                recognizer.start();
                document.getElementById("statusPasCurent").innerText = "🎤 Ascult comanda...";

                recognizer.onresult = function (event) {
                    const comanda = event.results[0][0].transcript.toLowerCase().trim();

                    if (comanda.includes("următor")) {
                        pasCurent = Math.min(pasCurent + 1, pasi.length - 1);
                        citestePas(pasCurent);
                    } else if (comanda.includes("repetă")) {
                        citestePas(pasCurent);
                    } else if (comanda.includes("pauză")) {
                        speechSynthesis.cancel();
                    } else {
                        const raspuns = new SpeechSynthesisUtterance("Comandă necunoscută.");
                        raspuns.lang = "ro-RO";
                        speechSynthesis.speak(raspuns);
                    }

                    actualizeazaStatus(pasCurent);
                };

                recognizer.onerror = function (event) {
                    console.error("Eroare recunoaștere vocală:", event.error);
                    document.getElementById("statusPasCurent").innerText = "❌ Eroare: " + event.error;
                };
            }
        </script>
    <script>
        function toggleEditForm() {
            var editForm = document.getElementById("editForm");
            if (editForm.style.display === "none") {
                editForm.style.display = "block";
            } else {
                editForm.style.display = "none";
            }
        }
    </script>
</body>
</html>
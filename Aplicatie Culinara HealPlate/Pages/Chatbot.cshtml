@page
@model Aplicatie_Culinara_HealPlate.Pages.ChatbotModel
@{
    ViewData["Title"] = "Chatbot AI";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="css/bootstrap.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f2f7f5;
            font-family: 'Segoe UI', sans-serif;
        }

        .chatbot-container {
            max-width: 850px;
            margin: 50px auto;
            padding: 30px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.08);
        }

        .chat-header {
            text-align: center;
            margin-bottom: 30px;
        }

            .chat-header h2 {
                color: #28a745;
                font-weight: bold;
            }

        .chat-bubble {
            max-width: 75%;
            padding: 15px;
            margin: 10px;
            border-radius: 20px;
            line-height: 1.5;
            word-wrap: break-word;
        }

        .bubble-user {
            background-color: #e9ecef;
            align-self: flex-start;
            margin-right: auto;
        }

        .bubble-bot {
            background-color: #d1e7dd;
            align-self: flex-end;
            margin-left: auto;
        }

        .chat-box {
            display: flex;
            flex-direction: column;
            gap: 5px;
            max-height: 400px;
            overflow-y: auto;
            margin-bottom: 30px;
        }

        textarea {
            resize: none;
        }

        .btn-submit {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .btn-back {
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container chatbot-container">
        <div class="btn-back">
            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Înapoi
            </a>
        </div>

        <div class="chat-header">
            <h2><i class="fas fa-robot me-2"></i>Chatbot Nutrițional AI</h2>
            <p class="text-muted">Discută cu AI-ul tău nutrițional. Fiecare întrebare primește un răspuns personalizat.</p>
        </div>

        @if (Model.Conversatie != null && Model.Conversatie.Any())
        {
            <div class="chat-box d-flex flex-column">
                @foreach (var msg in Model.Conversatie)
                {
                    <div class="chat-bubble bubble-user">
                        <strong>Tu:</strong> @msg.Intrebare
                    </div>
                    <div class="chat-bubble bubble-bot">
                        <strong>AI:</strong> @Html.Raw(msg.Raspuns)
                    </div>
                }
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="Prompt" class="form-label">Scrie o nouă întrebare:</label>
                <textarea asp-for="Prompt" class="form-control" rows="4" placeholder="Ex: Sunt alergic la lactate, ce pot mânca?"></textarea>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-success btn-lg btn-submit">
                    <i class="fas fa-paper-plane"></i> Trimite
                </button>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
